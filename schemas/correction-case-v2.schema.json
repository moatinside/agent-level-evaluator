{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction-case-v2.schema.json",
  "title": "Human-confirmed correction case candidate v2 (positions only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_ref", "case_kind", "source", "human_failure", "target", "correction_summary", "expected_behavior", "regression_input", "post_correction_observation", "case_status", "execution_status", "approval_status", "created_at"],
  "properties": {
    "schema_version": {"const": 2},
    "case_ref": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "case_kind": {"const": "human_confirmed_correction_candidate"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_ref", "input_hash", "axis"],
      "properties": {
        "evaluation_ref": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
        "input_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "axis": {"type": "string"}
      }
    },
    "human_failure": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"const": "fail"}, "reason": {"const": "omitted_by_privacy_policy"}}
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["position", "start", "end", "role"],
      "properties": {"position": {"type": "integer", "minimum": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "role": {"const": "assistant"}}
    },
    "correction_summary": {"const": "omitted_by_privacy_policy"},
    "expected_behavior": {"const": "omitted_by_privacy_policy"},
    "regression_input": {
      "type": "object", "additionalProperties": false,
      "required": ["messages_before_target", "context_status", "after_correction_answer_or_label_included"],
      "properties": {
        "messages_before_target": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["position", "role", "start", "end"],
            "properties": {"position": {"type": "integer", "minimum": 1}, "role": {"enum": ["user", "assistant"]}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
          }
        },
        "context_status": {"enum": ["no_context_spans", "positions_only_review_required"]},
        "after_correction_answer_or_label_included": {"const": false}
      }
    },
    "post_correction_observation": {
      "type": "object", "additionalProperties": false, "required": ["status", "position"],
      "properties": {"status": {"const": "not_observed"}, "position": {"type": "null"}}
    },
    "case_status": {"const": "candidate_pending_context_review"},
    "execution_status": {"const": "not_run"},
    "approval_status": {"const": "pending"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
