{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "task_id", "conditions", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition_id", "type", "required"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["command_exit_zero", "tests_pass", "artifact_present"]},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition_id", "status", "verifier"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "failed"]},
          "verifier": {"const": "deterministic"},
          "exit_code": {"type": "integer"},
          "pass_count": {"type": "integer", "minimum": 0},
          "fail_count": {"type": "integer", "minimum": 0},
          "artifact_ref": {"type": "string", "pattern": "^artifact:sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
