{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-level-evaluator:runtime-evidence-envelope:2",
  "title": "Runtime Evidence Envelope V2",
  "description": "Metadata-only transport event. This is not an assessment record and cannot carry a semantic verdict or Level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_ref",
    "payload_hash",
    "observed_at",
    "provenance",
    "execution",
    "trace",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_type": {
      "const": "turn_settled"
    },
    "event_ref": {
      "type": "string",
      "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
      "maxLength": 96
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "maxLength": 71
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "maxLength": 32
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_origin",
        "source_class",
        "task_class",
        "classification_basis",
        "platform",
        "profile_ref",
        "session_ref",
        "episode_ref",
        "scope_ref"
      ],
      "properties": {
        "trigger_origin": {
          "const": "hermes_gateway"
        },
        "source_class": {
          "enum": [
            "ordinary_runtime",
            "controlled_fixture",
            "unknown"
          ]
        },
        "task_class": {
          "enum": [
            "ordinary_task",
            "command",
            "internal_event",
            "explicit_evaluation",
            "unknown"
          ]
        },
        "classification_basis": {
          "enum": [
            "gateway_dispatch",
            "test_harness",
            "unknown"
          ]
        },
        "platform": {
          "enum": [
            "discord",
            "telegram",
            "cli",
            "api",
            "unknown"
          ]
        },
        "profile_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
          "maxLength": 96
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
          "maxLength": 96
        },
        "episode_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
          "maxLength": 96
        },
        "scope_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
          "maxLength": 96
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "terminal_status",
        "started_at",
        "ended_at",
        "persistence_status",
        "persistence_receipt_ref",
        "delivery_status",
        "runtime_build_id",
        "agent_configuration_id",
        "capture_configuration_id"
      ],
      "properties": {
        "execution_mode": {
          "const": "shadow"
        },
        "terminal_status": {
          "enum": [
            "completed",
            "failed",
            "interrupted",
            "skipped",
            "unknown"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
          "maxLength": 32
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
          "maxLength": 32
        },
        "persistence_status": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "not_applicable",
            "unknown"
          ]
        },
        "persistence_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hmac-sha256:v[1-9][0-9]*:[a-f0-9]{64}$",
          "maxLength": 96
        },
        "delivery_status": {
          "enum": [
            "delivered",
            "suppressed",
            "not_attempted",
            "unknown"
          ]
        },
        "runtime_build_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "maxLength": 71
        },
        "agent_configuration_id": {
          "type": "null"
        },
        "capture_configuration_id": {
          "type": "null"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_count",
        "tool_call_count",
        "tool_error_count",
        "correction_count",
        "evidence_reference_count",
        "iteration_count"
      ],
      "properties": {
        "turn_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "tool_call_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "tool_error_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "correction_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "evidence_reference_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "iteration_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_status",
        "measurement_status",
        "evaluation_eligibility"
      ],
      "properties": {
        "transport_status": {
          "const": "captured"
        },
        "measurement_status": {
          "enum": [
            "not_assessed",
            "partial",
            "not_observable"
          ]
        },
        "evaluation_eligibility": {
          "enum": [
            "transport_only",
            "excluded"
          ]
        }
      }
    }
  }
}
