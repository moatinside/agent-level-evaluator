{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moatinside/agent-level-evaluator/schemas/evidence-record.schema.json",
  "title": "Agent Level Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_id", "level", "capability_id",
    "capability_contract_version", "agent_configuration_id",
    "evaluator_configuration_id", "evidence_class", "scenario_id",
    "trigger_origin", "environment_class", "started_at", "ended_at",
    "input_ref", "expected_contract", "result", "reviewer",
    "integrity_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "level": {"type": "integer", "minimum": 1, "maximum": 9},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "capability_contract_version": {"type": "string", "minLength": 1},
    "agent_configuration_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_configuration_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_class": {"type": "string", "enum": ["S", "F", "X", "O", "R", "N"]},
    "scenario_id": {"type": "string", "minLength": 1},
    "trigger_origin": {"type": "string", "enum": ["user", "agent", "harness", "cron"]},
    "environment_class": {"type": "string", "enum": ["fixture", "sandbox", "shadow", "production-like", "production"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "input_ref": {"type": "string", "minLength": 1},
    "expected_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "action_trace_ref": {"type": "string"},
    "draft_ref": {"type": "string"},
    "validator_report_ref": {"type": "string"},
    "revision_diff_ref": {"type": "string"},
    "final_output_ref": {"type": "string"},
    "result": {"type": "string", "enum": ["passed", "failed", "blocked", "inconclusive"]},
    "acceptance_results": {"type": "object"},
    "negative_evidence": {"type": "array", "items": {"type": "object"}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "rollback_result": {"type": "string", "enum": ["not_required", "passed", "failed", "unknown"]},
    "reviewer": {"type": "string", "enum": ["deterministic", "independent-agent", "human"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "integrity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "O"}}},
      "then": {"required": ["action_trace_ref"]}
    },
    {
      "if": {"properties": {"evidence_class": {"const": "F"}}},
      "then": {"required": ["acceptance_results"]}
    }
  ]
}
